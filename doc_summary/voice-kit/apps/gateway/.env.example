# voice-kit gateway — required environment
# Copy to `.env` and fill in real credentials. Never commit `.env`.

# --- Volcengine Doubao (ASR / TTS / Realtime) ------------------------------
# Get from https://www.volcengine.com  (产品 → 语音技术 → 应用管理)
VK_DOUBAO_APP_ID=
# Either an AK/SK pair (preferred for production) or a pre-minted access token
VK_DOUBAO_API_KEY=
VK_DOUBAO_API_SECRET=
VK_DOUBAO_ACCESS_TOKEN=
# Default resource id for v3/sauc streaming ASR
VK_DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration

# Endpoint overrides only needed for testing or private deployments
# VK_DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# VK_DOUBAO_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection

# Realtime (bidirectional ASR+TTS) — optional, leave unset to disable
# VK_DOUBAO_REALTIME_APP_ID=
# VK_DOUBAO_REALTIME_TOKEN=
# VK_DOUBAO_REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/realtime

# --- Zhipu GLM (TTS / LLM) -------------------------------------------------
# VK_ZHIPU_API_KEY=
# VK_ZHIPU_API_SECRET=
# VK_ZHIPU_BASE_URL=

# --- MiniMax (TTS) --------------------------------------------------------
# VK_MINIMAX_API_KEY=
# VK_MINIMAX_GROUP_ID=
# VK_MINIMAX_BASE_URL=

# --- Gateway transport ----------------------------------------------------
VK_GATEWAY_PORT=8787
# Comma-separated allowlist, or "*" for any origin (dev only)
VK_CORS_ORIGINS=*
# Client JWT TTL (seconds). Keep short; clients refresh.
VK_TOKEN_TTL_SEC=300
