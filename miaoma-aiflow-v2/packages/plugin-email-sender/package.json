{
    "name": "@miaoma-aiflow/plugin-email-sender",
    "private": true,
    "version": "1.0.0",
    "description": "邮件发送远程插件",
    "type": "module",
    "main": "dist/executor.umd.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "tsup.config.ts",
        "plugin.json",
        "README.md",
        "tsconfig.json"
    ],
    "scripts": {
        "build": "tsup --config tsup.config.ts",
        "watch": "tsup --config tsup.config.ts --watch",
        "typecheck": "tsc --noEmit",
