    },
    "keywords": [
        "miaoma",
        "plugin",
        "email",
        "smtp",
        "notification",
        "workflow"
    ],
    "author": {
        "name": "妙码学院",
        "email": "support@miaomaedu.com"
    },
    "license": "MIT",
    "devDependencies": {
        "@miaoma-aiflow/plugin-core": "workspace:*",
        "tsup": "^8.3.5",
        "typescript": "^5.0.0"
    }
}
