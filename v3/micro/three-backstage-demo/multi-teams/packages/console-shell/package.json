{
  "name": "@console/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Console Shell - 平台架构组维护，提供 Header/Sidebar/iframe 路由代理",
  "scripts": {
    "dev": "vite --port 5180 --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5181",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}